# =====================================================================
# Ligase configuration: copy to .env (./install.sh does this for you)
# Set ONE model below. `ligase doctor` tells you whether it works.
# =====================================================================

# --- Option A: private OpenAI-compatible model (Muse Glimmer, vLLM, SGLang) ---
# Do not commit a real host.
# GLIMMER_30B_BACKEND=http://<host>:<port>/v1
# GLIMMER_30B_MODEL=Muse-Glimmer-30B
# GLIMMER_API_KEY=not-needed

# --- Option B: OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# --- Option C: any other OpenAI-compatible server (`ligase --model custom`) ---
# LIGASE_BASE_URL=http://localhost:8000/v1
# LIGASE_MODEL=your-model-name
# LIGASE_API_KEY=not-needed

# --- Option D: local Gemma GGUF server (`ligase --model gemma`) ---
# GEMMA_AGENTIC_BASE_URL=http://127.0.0.1:18080/v1
# GEMMA_AGENTIC_MODEL=gemma4-agentic-v2

# Optional
# NCBI_API_KEY=your_ncbi_api_key_here      # higher PubMed/BLAST rate limits
# LIGASE_DATA_PATH=./data                  # local data lake
PROVIDER=openai
STREAMING=1
MAX_ITERATIONS=30
CLAW_TRAJECTORY=1
CLAW_LEARN=0
